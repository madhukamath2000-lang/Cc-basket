<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-title" content="CC Basket"/>
<title>CC Basket · Live</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{background:#050c17;color:#f1f5f9;font-family:-apple-system,'Segoe UI',sans-serif;min-height:100vh;overflow-x:hidden}
.hdr{background:#0a1628;border-bottom:1px solid #1e3a5f;padding:14px 16px;position:sticky;top:0;z-index:100}
.hdr-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.title{font-size:16px;font-weight:800;color:#f8fafc}
.sub{color:#7dd3fc;font-size:11px;margin-top:3px}
.pnl-big{font-size:18px;font-weight:800;font-family:monospace}
.mbar{background:#0f2744;border:1px solid #1e3a5f;border-radius:8px;padding:9px 12px;margin-bottom:10px}
.mtags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:5px}
.mtag{padding:2px 8px;border-radius:5px;font-size:10px;font-weight:800;border:1px solid}
.chips{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.chip{background:#0f2744;border-radius:8px;padding:9px 4px;text-align:center;border:1px solid #1e3a5f}
.chip-l{color:#93c5fd;font-size:9px;margin-bottom:3px;font-weight:700}
.chip-v{font-weight:800;font-size:12px;font-family:monospace}
.rbtn{width:100%;background:#1e3a5f;border:none;color:#7dd3fc;border-radius:8px;padding:10px;cursor:pointer;font-size:12px;font-weight:700;margin-top:10px}
.tabs{display:flex;background:#0a1628;border-bottom:2px solid #1e3a5f;overflow-x:auto}
.tbtn{background:none;border:none;border-bottom:3px solid transparent;color:#7dd3fc;padding:11px 16px;cursor:pointer;font-size:12px;font-weight:700;white-space:nowrap;text-transform:uppercase;margin-bottom:-2px}
.tbtn.on{border-bottom-color:#60a5fa;color:#f8fafc}
.cnt{padding:14px}
.slbl{color:#93c5fd;font-size:11px;font-weight:700;letter-spacing:.06em;margin-bottom:10px}
.card{background:#0a1628;border:2px solid #1e3a5f;border-radius:12px;padding:14px;margin-bottom:12px;position:relative;overflow:hidden;cursor:pointer}
.bdg{position:absolute;top:0;right:0;color:#fff;font-size:10px;font-weight:900;padding:4px 10px;border-radius:0 12px 0 8px}
.ctop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.cname{display:flex;align-items:center;gap:7px}
.dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.sname{color:#f8fafc;font-weight:800;font-size:15px}
.ssub{color:#93c5fd;font-size:11px;margin-left:16px;margin-top:2px}
.dgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px}
.dc{background:#0f2744;border-radius:8px;padding:8px 6px;text-align:center;border:1px solid #1e3a5f}
.dl{color:#93c5fd;font-size:9px;margin-bottom:3px;font-weight:700}
.dv{font-size:12px;font-weight:800;font-family:monospace}
.bwrap{margin-bottom:8px}
.btop{display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px}
.btrk{background:#1e293b;border-radius:4px;height:7px;overflow:hidden}
.bfil{height:100%;border-radius:4px;transition:width 1s}
.cbox{border-radius:8px;padding:9px 10px;border:1px solid;font-size:12px;line-height:1.5}
.err{background:#1a0000;border:2px solid #f87171;border-radius:10px;padding:16px;margin-bottom:14px}
.ld{text-align:center;padding:40px}
.aalert{background:#052e16;border:2px solid #16a34a;border-radius:10px;padding:12px 14px;margin-bottom:14px}
.atitle{color:#4ade80;font-weight:800;font-size:13px;margin-bottom:6px}
.atext{color:#bbf7d0;font-size:12px;line-height:1.8}
.bbtn{background:#1e3a5f;border:none;color:#f8fafc;border-radius:8px;padding:8px 16px;cursor:pointer;font-size:12px;font-weight:700;margin-bottom:14px}
.dcard{background:#0a1628;border-radius:14px;padding:16px}
.dhdr{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.dico{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center}
.fmbox{border-radius:10px;padding:13px;margin-bottom:14px;border:1.5px solid}
.fmlbl{font-size:11px;font-weight:800;margin-bottom:6px}
.fmtxt{color:#e2e8f0;font-size:13px;line-height:1.75}
.ngrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.nc{background:#0f2744;border-radius:9px;padding:11px 8px;text-align:center;border:1px solid #1e3a5f}
.nl{color:#93c5fd;font-size:10px;margin-bottom:4px;font-weight:700}
.nv{font-weight:800;font-size:14px;font-family:monospace}
.dbox{background:#0f2744;border-radius:10px;padding:13px;border:1px solid #1e3a5f}
.srw{background:#0a1628;border:2px solid #1e3a5f;border-radius:12px;padding:14px;margin-bottom:12px;cursor:pointer}
.stop{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:10px}
.stag{border-radius:6px;padding:3px 10px;font-size:11px;font-weight:800;white-space:nowrap;border:1.5px solid}
.mgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.mc{background:#0f2744;border-radius:7px;padding:8px;text-align:center;border:1px solid #1e3a5f}
.ml{color:#93c5fd;font-size:9px;font-weight:700;margin-bottom:2px}
.mv{font-weight:800;font-size:12px}
.csec{background:#0a1628;border-radius:12px;padding:16px;margin-bottom:14px;border:2px solid}
.citm{display:flex;gap:12px;margin-bottom:12px;align-items:flex-start;cursor:pointer}
.cbx{width:22px;height:22px;border-radius:6px;border:2px solid;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.clsd{background:#0a1628;border:1px solid #1e3a5f;border-radius:12px;padding:14px;margin-bottom:10px;opacity:.7}
.setup{background:#0f2744;border:2px solid #60a5fa;border-radius:12px;padding:18px;margin-bottom:14px}
.step{display:flex;gap:12px;margin-bottom:14px;align-items:flex-start}
.stepnum{width:28px;height:28px;border-radius:50%;background:#1d4ed8;color:#fff;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.steptext{color:#bae6fd;font-size:12px;line-height:1.7}
.steptext b{color:#f8fafc}
</style>
</head>
<body>
<div class="hdr">
  <div class="hdr-top">
    <div><div class="title">📊 CC BASKET · LIVE</div><div class="sub" id="tdisp">Connecting...</div></div>
    <div style="text-align:right"><div class="pnl-big" id="tpnl" style="color:#4ade80">+₹0</div><div style="color:#7dd3fc;font-size:10px">OVERALL P&L</div></div>
  </div>
  <div class="mbar">
    <div class="mtags">
      <span class="mtag" style="color:#f87171;border-color:#f87171;background:rgba(248,113,113,.1)">BEARISH</span>
      <span class="mtag" style="color:#fbbf24;border-color:#fbbf24;background:rgba(251,191,36,.1)">VIX ELEVATED</span>
      <span class="mtag" style="color:#4ade80;border-color:#4ade80;background:rgba(74,222,128,.1)">GOOD FOR CC</span>
    </div>
    <div style="color:#bae6fd;font-size:11px;line-height:1.5">Falling market = stocks moving away from strikes. Elevated IV = fatter premiums.</div>
  </div>
  <div class="chips">
    <div class="chip"><div class="chip-l">DAY P&L</div><div class="chip-v" id="dpnl" style="color:#4ade80">+₹0</div></div>
    <div class="chip"><div class="chip-l">OVERALL</div><div class="chip-v" id="opnl" style="color:#4ade80">+₹0</div></div>
    <div class="chip"><div class="chip-l">POSITIONS</div><div class="chip-v" id="pcnt" style="color:#f8fafc">0</div></div>
    <div class="chip"><div class="chip-l">ACTIONS</div><div class="chip-v" id="acnt" style="color:#4ade80">0</div></div>
  </div>
  <button class="rbtn" onclick="fetchData()" id="rfbtn">⟳ Refresh Live Data</button>
</div>
<div class="tabs">
  <button class="tbtn on" onclick="switchTab('positions',this)">Positions</button>
  <button class="tbtn" onclick="switchTab('signals',this)">Signals</button>
  <button class="tbtn" onclick="switchTab('checklist',this)">Checklist</button>
</div>
<div class="cnt" id="cnt"></div>

<script>
// ── YOUR BACKEND URL — update this after deploying to Render ──
let API_BASE = localStorage.getItem("api_base") || "";

const MY_SL={
  HDFCBANK:  {sl:24,   slAmt:13200,color:"#60a5fa",sector:"Banking"},
  ICICIBANK: {sl:40,   slAmt:28000,color:"#38bdf8",sector:"Banking"},
  INFY:      {sl:36,   slAmt:14400,color:"#a78bfa",sector:"IT"},
  MAZDOCK:   {sl:105,  slAmt:21000,color:"#fbbf24",sector:"Defence"},
  RELIANCE:  {sl:60,   slAmt:30000,color:"#fb923c",sector:"Energy"},
  TATAMOTORS:{sl:15,   slAmt:12000,color:"#f472b6",sector:"Auto"},
  SUNPHARMA: {sl:26.10,slAmt:0,    color:"#34d399",sector:"Pharma"},
};

const FALLBACK=[
  {trading_symbol:"HDFCBANK 800 CE",last_price:9.00,average_price:17.25,quantity:-550,pnl:4537.50,day_pnl:0},
  {trading_symbol:"ICICIBANK 1300 CE",last_price:10.25,average_price:10.50,quantity:-700,pnl:175.00,day_pnl:0},
  {trading_symbol:"INFY 1230 CE",last_price:14.20,average_price:24.05,quantity:-400,pnl:3940.00,day_pnl:0},
  {trading_symbol:"MAZDOCK 2700 CE",last_price:79.95,average_price:83.05,quantity:-200,pnl:620.00,day_pnl:0},
  {trading_symbol:"RELIANCE 1500 CE",last_price:13.90,average_price:15.60,quantity:-500,pnl:850.00,day_pnl:0},
  {trading_symbol:"TATAMOTORS 370 CE",last_price:3.30,average_price:10.30,quantity:-800,pnl:5600.00,day_pnl:0},
];

let positions=[], tab="positions", sel=null, checks={}, usingFallback=false;

const inr=n=>`₹${Math.abs(Number(n)).toLocaleString('en-IN',{maximumFractionDigits:0})}`;
const pc=n=>n>=0?"#4ade80":"#f87171";
const ps=n=>`${n>=0?"+":""}${inr(n)}`;
const sym=ts=>ts?.split(" ")[0]||"";
const decay=(avg,ltp)=>avg>0?Math.min(100,Math.max(0,((avg-ltp)/avg)*100)):0;
const dc=d=>d>60?"#4ade80":d>30?"#fbbf24":"#f87171";

function sig(pos){
  const ltp=pos.last_price,avg=pos.average_price,s=MY_SL[sym(pos.trading_symbol)],sl=s?.sl||999;
  const d=decay(avg,ltp),bb=+(avg*.3).toFixed(2);
  if(ltp>sl) return{s:"🚨 SL HIT",c:"#f87171",d,bb,p:0};
  if(ltp<=bb||d>=65) return{s:"✓ BUY BACK",c:"#4ade80",d,bb,p:1};
  if(sym(pos.trading_symbol)==="MAZDOCK"&&d<10) return{s:"⚠ WATCH",c:"#fbbf24",d,bb,p:2};
  if(d>40) return{s:"HOLD ✓",c:"#60a5fa",d,bb,p:3};
  return{s:"HOLD",c:"#94a3b8",d,bb,p:4};
}

function callText(pos,sg){
  const ltp=pos.last_price,sl=MY_SL[sym(pos.trading_symbol)]?.sl;
  if(sg.s.includes("SL HIT")) return`URGENT: LTP ₹${ltp} breached SL ₹${sl}. Exit now. Do not average.`;
  if(sg.s.includes("BUY BACK")) return`${sg.d.toFixed(0)}% decayed. Buy back @ ₹${ltp}. Lock profit. Reload June cycle.`;
  if(sg.s.includes("WATCH")) return`LTP rising — monitor closely. Consider buying back if approaches ₹${(sl*.85).toFixed(0)}.`;
  if(sg.s.includes("HOLD ✓")) return`${sg.d.toFixed(0)}% decayed — good pace. Hold. BB target ₹${sg.bb}. GTT SL ₹${sl} protecting you.`;
  return`On track. ${sg.d.toFixed(0)}% decayed. Hold and monitor. BB target ₹${sg.bb}.`;
}

function updateTime(){
  const ist=new Date().toLocaleTimeString("en-IN",{timeZone:"Asia/Kolkata",hour:"2-digit",minute:"2-digit"});
  const syd=new Date().toLocaleTimeString("en-AU",{hour:"2-digit",minute:"2-digit"});
  document.getElementById("tdisp").textContent=`${ist} IST · ${syd} Sydney · ● Live`;
}

async function fetchData(){
  const btn=document.getElementById("rfbtn");
  btn.textContent="⟳ Syncing..."; btn.disabled=true;

  if(!API_BASE){
    showSetup();
    btn.textContent="⟳ Refresh Live Data"; btn.disabled=false;
    return;
  }

  document.getElementById("cnt").innerHTML=`<div class="ld"><div style="color:#60a5fa;font-size:14px;font-weight:700">⟳ Fetching live positions...</div></div>`;

  try{
    const r=await fetch(`${API_BASE}/positions`,{signal:AbortSignal.timeout(10000)});
    const data=await r.json();
    if(data.status==="success"){
      positions=data.data||[];
      usingFallback=false;
      updateSummary();
      renderTab();
    } else {
      throw new Error(data.errors?.[0]?.message||"API error");
    }
  } catch(e){
    // Use fallback data
    positions=FALLBACK;
    usingFallback=true;
    updateSummary();
    renderTab();
  }

  btn.textContent="⟳ Refresh Live Data"; btn.disabled=false;
}

function showSetup(){
  document.getElementById("cnt").innerHTML=`
    <div class="setup">
      <div style="color:#60a5fa;font-weight:800;font-size:15px;margin-bottom:16px">🔧 One-Time Setup Required</div>
      <div style="color:#bae6fd;font-size:12px;margin-bottom:16px;line-height:1.6">To get live data, you need to deploy a free backend on Render.com. Takes 5 minutes.</div>

      <div class="step"><div class="stepnum">1</div><div class="steptext">Go to <b>github.com</b> → Sign up free → Create new repository called <b>cc-basket</b></div></div>
      <div class="step"><div class="stepnum">2</div><div class="steptext">Upload the 3 files I gave you: <b>main.py, requirements.txt, render.yaml</b></div></div>
      <div class="step"><div class="stepnum">3</div><div class="steptext">Go to <b>render.com</b> → Sign up free → New Web Service → Connect your GitHub repo</div></div>
      <div class="step"><div class="stepnum">4</div><div class="steptext">Render will give you a URL like <b>https://cc-basket.onrender.com</b> — paste it below</div></div>

      <div style="margin-top:16px">
        <div style="color:#93c5fd;font-size:11px;font-weight:700;margin-bottom:6px">YOUR RENDER URL:</div>
        <input id="apiInput" type="url" placeholder="https://cc-basket.onrender.com" style="width:100%;background:#0a1628;border:1px solid #1e3a5f;color:#f8fafc;border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:10px"/>
        <button onclick="saveUrl()" style="width:100%;background:#1d4ed8;border:none;color:#fff;border-radius:8px;padding:12px;cursor:pointer;font-size:13px;font-weight:700">✓ Save & Connect</button>
      </div>

      <div style="margin-top:14px;padding-top:14px;border-top:1px solid #1e3a5f">
        <div style="color:#fbbf24;font-size:11px;font-weight:700;margin-bottom:6px">OR — Use last known data</div>
        <button onclick="useFallback()" style="width:100%;background:#1c1000;border:1px solid #d97706;color:#fbbf24;border-radius:8px;padding:10px;cursor:pointer;font-size:12px;font-weight:700">Show Last Screenshot Data</button>
      </div>
    </div>`;
}

function saveUrl(){
  const url=document.getElementById("apiInput").value.trim().replace(/\/$/,"");
  if(!url.startsWith("http")){alert("Please enter a valid URL");return;}
  API_BASE=url;
  localStorage.setItem("api_base",url);
  fetchData();
}

function useFallback(){
  positions=FALLBACK;
  usingFallback=true;
  updateSummary();
  renderTab();
}

function updateSummary(){
  const open=positions.filter(p=>p.quantity!==0);
  const tp=positions.reduce((a,p)=>a+(p.pnl||0),0);
  const dp=positions.reduce((a,p)=>a+(p.day_pnl||0),0);
  const ac=open.filter(p=>sig(p).p<=1).length;
  document.getElementById("tpnl").textContent=ps(tp);
  document.getElementById("tpnl").style.color=pc(tp);
  document.getElementById("dpnl").textContent=ps(dp);
  document.getElementById("dpnl").style.color=pc(dp);
  document.getElementById("opnl").textContent=ps(tp);
  document.getElementById("opnl").style.color=pc(tp);
  document.getElementById("pcnt").textContent=open.length;
  document.getElementById("acnt").textContent=ac;
  document.getElementById("acnt").style.color=ac>0?"#fbbf24":"#4ade80";
}

function switchTab(t,el){
  tab=t; sel=null;
  document.querySelectorAll(".tbtn").forEach(b=>b.classList.remove("on"));
  el.classList.add("on");
  renderTab();
}

function renderTab(){
  if(tab==="positions") renderPositions();
  else if(tab==="signals") renderSignals();
  else renderChecklist();
}

function buildCards(open){
  let h="";
  open.sort((a,b)=>sig(a).p-sig(b).p).forEach(pos=>{
    const s=MY_SL[sym(pos.trading_symbol)]||{};
    const sg=sig(pos),cl=callText(pos,sg);
    const pnl=pos.pnl||0,ltp=pos.last_price,avg=pos.average_price;
    const alert=sg.p<=1;
    const bBg=sg.s.includes("BUY BACK")?"#16a34a":sg.s.includes("SL HIT")?"#dc2626":sg.s.includes("WATCH")?"#d97706":"";
    const bTx=sg.s.includes("BUY BACK")?"CLOSE NOW":sg.s.includes("SL HIT")?"ACTION!":sg.s.includes("WATCH")?"WATCH":"";
    const cbg=alert?sg.c+"15":"#0f2744",cbr=alert?sg.c:"#1e3a5f",ctx=alert?sg.c:"#bae6fd";
    h+=`<div class="card" style="border-color:${alert?sg.c:'#1e3a5f'}" onclick="selPos('${pos.trading_symbol}')">
      ${bTx?`<div class="bdg" style="background:${bBg}">${bTx}</div>`:""}
      <div class="ctop">
        <div><div class="cname"><div class="dot" style="background:${s.color||'#60a5fa'}"></div><span class="sname">${pos.trading_symbol}</span></div>
        <div class="ssub">${Math.abs(pos.quantity)} qty · ${s.sector||""}</div></div>
        <div style="text-align:right"><div class="pnl-big" style="color:${pc(pnl)};font-size:15px">${ps(pnl)}</div><div style="color:#7dd3fc;font-size:10px">P&L</div></div>
      </div>
      <div class="dgrid">
        <div class="dc"><div class="dl">AVG</div><div class="dv" style="color:#cbd5e1">₹${avg?.toFixed(2)}</div></div>
        <div class="dc"><div class="dl">LTP</div><div class="dv" style="color:${ltp>(s.sl||999)?"#f87171":"#f8fafc"}">₹${ltp?.toFixed(2)}</div></div>
        <div class="dc"><div class="dl">SL AMT</div><div class="dv" style="color:#f87171">${inr(s.slAmt||0)}</div></div>
        <div class="dc"><div class="dl">DECAY</div><div class="dv" style="color:${dc(sg.d)}">${sg.d.toFixed(0)}%</div></div>
      </div>
      <div class="bwrap"><div class="btop"><span style="color:#93c5fd;font-weight:600">Premium decay</span><span style="color:${dc(sg.d)};font-weight:800">${sg.d.toFixed(0)}%</span></div>
      <div class="btrk"><div class="bfil" style="width:${sg.d}%;background:${dc(sg.d)}"></div></div></div>
      <div class="cbox" style="background:${cbg};border-color:${cbr};color:${ctx}">→ ${cl}</div>
    </div>`;
  });
  return h;
}

function renderPositions(){
  if(sel){renderDetail();return}
  const open=positions.filter(p=>p.quantity!==0);
  const closed=positions.filter(p=>p.quantity===0);
  const urgent=open.filter(p=>sig(p).p<=1);
  let h="";

  if(usingFallback) h+=`<div style="background:#0f2744;border:1px solid #fbbf24;border-radius:8px;padding:10px 12px;margin-bottom:14px;color:#fbbf24;font-size:11px">⚠ Showing last known data. <span onclick="showSetup()" style="text-decoration:underline;cursor:pointer">Connect live data →</span></div>`;

  if(urgent.length>0){
    h+=`<div class="aalert"><div class="atitle">⚡ Action Required</div><div class="atext">`;
    urgent.forEach(p=>{const sg=sig(p);h+=`<b>${p.trading_symbol}</b> — ${sg.s}<br/>`;});
    h+=`</div></div>`;
  }
  h+=`<div class="slbl">OPEN · ${open.length} POSITIONS</div>`;
  h+=buildCards(open);
  if(closed.length>0){
    h+=`<div class="slbl" style="margin-top:4px">CLOSED THIS CYCLE</div>`;
    closed.forEach(p=>{
      const pnl=p.pnl||0;
      h+=`<div class="clsd"><div style="display:flex;justify-content:space-between;align-items:center"><div><div class="sname" style="font-size:14px">${p.trading_symbol}</div><div class="ssub" style="margin-left:0">Avg ₹${p.average_price?.toFixed(2)} · Closed</div></div><div class="pnl-big" style="color:${pc(pnl)};font-size:14px">${ps(pnl)}</div></div></div>`;
    });
  }
  document.getElementById("cnt").innerHTML=h;
}

function selPos(symbol){sel=symbol;renderDetail()}

function renderDetail(){
  const pos=positions.find(p=>p.trading_symbol===sel);
  if(!pos){sel=null;renderPositions();return}
  const s=MY_SL[sym(pos.trading_symbol)]||{};
  const sg=sig(pos),cl=callText(pos,sg);
  const pnl=pos.pnl||0,ltp=pos.last_price,avg=pos.average_price,bb=(avg*.3).toFixed(2);
  const dcl=dc(sg.d),fbg=sg.s.includes("BUY BACK")?"#052e16":sg.s.includes("WATCH")?"#1c1000":"#0f2744";
  document.getElementById("cnt").innerHTML=`
    <button class="bbtn" onclick="sel=null;renderPositions()">← Back</button>
    <div class="dcard" style="border:2px solid ${s.color||'#60a5fa'}">
      <div class="dhdr">
        <div class="dico" style="background:${s.color||'#60a5fa'}25"><div class="dot" style="width:16px;height:16px;background:${s.color||'#60a5fa'}"></div></div>
        <div><div style="color:#f8fafc;font-weight:800;font-size:17px">${pos.trading_symbol}</div><div style="color:#93c5fd;font-size:12px">${s.sector||""} · ${Math.abs(pos.quantity)} qty</div></div>
      </div>
      <div class="fmbox" style="background:${fbg};border-color:${sg.c}">
        <div class="fmlbl" style="color:${sg.c}">🧠 FUND MANAGER CALL</div>
        <div class="fmtxt">${cl}</div>
      </div>
      <div class="ngrid">
        <div class="nc"><div class="nl">Avg Sold</div><div class="nv" style="color:#cbd5e1">₹${avg?.toFixed(2)}</div></div>
        <div class="nc"><div class="nl">LTP</div><div class="nv" style="color:${ltp>(s.sl||999)?"#f87171":"#f8fafc"}">₹${ltp?.toFixed(2)}</div></div>
        <div class="nc"><div class="nl">Stop Loss</div><div class="nv" style="color:#f87171">₹${s.sl||"—"}</div></div>
        <div class="nc"><div class="nl">Max Income</div><div class="nv" style="color:#4ade80">${inr(avg*Math.abs(pos.quantity))}</div></div>
        <div class="nc"><div class="nl">Profit Now</div><div class="nv" style="color:${pc(pnl)}">${ps(pnl)}</div></div>
        <div class="nc"><div class="nl">SL Amount</div><div class="nv" style="color:#f87171">${inr(s.slAmt||0)}</div></div>
      </div>
      <div class="dbox">
        <div style="display:flex;justify-content:space-between;margin-bottom:7px"><span style="color:#93c5fd;font-size:11px;font-weight:700">⏱ Premium Decay</span><span style="color:#7dd3fc;font-size:11px">BB @ ₹${bb}</span></div>
        <div class="btrk"><div class="bfil" style="width:${sg.d}%;background:${dcl}"></div></div>
        <div style="display:flex;justify-content:space-between;margin-top:7px;font-size:11px">
          <span style="color:#93c5fd">₹${avg?.toFixed(2)} sold</span>
          <span style="color:${dcl};font-weight:800">${sg.d.toFixed(0)}% done</span>
          <span style="color:#93c5fd">₹${bb} target</span>
        </div>
        <div style="margin-top:8px;font-size:12px;font-weight:700;color:${dcl}">${sg.d>65?"🟢 Near buy-back — get ready":sg.d>35?"🟡 On track — hold":"🔴 Early stage — watch"}</div>
      </div>
    </div>`;
}

function renderSignals(){
  const open=positions.filter(p=>p.quantity!==0).sort((a,b)=>sig(a).p-sig(b).p);
  const ist=new Date().toLocaleTimeString("en-IN",{timeZone:"Asia/Kolkata",hour:"2-digit",minute:"2-digit"});
  let h=`<div style="background:#0f2744;border:1px solid #1e3a5f;border-radius:10px;padding:11px 14px;margin-bottom:14px"><div style="color:#f8fafc;font-weight:800;font-size:13px;margin-bottom:4px">Live Signals — ${ist} IST</div><div style="color:#bae6fd;font-size:12px;line-height:1.6">Sorted by urgency. Tap row for full detail.</div></div>`;
  open.forEach(pos=>{
    const s=MY_SL[sym(pos.trading_symbol)]||{};
    const sg=sig(pos),cl=callText(pos,sg);
    const pnl=pos.pnl||0,ltp=pos.last_price,avg=pos.average_price;
    const alert=sg.p<=1,cbg=alert?sg.c+"15":"#0f2744",cbr=alert?sg.c:"#1e3a5f";
    h+=`<div class="srw" style="border-color:${alert?sg.c:'#1e3a5f'}" onclick="tab='positions';selPos('${pos.trading_symbol}')">
      <div class="stop">
        <div style="flex:1"><div style="color:#f8fafc;font-weight:800;font-size:14px">${pos.trading_symbol}</div><div style="color:#93c5fd;font-size:11px;margin-top:2px">LTP ₹${ltp?.toFixed(2)} · Avg ₹${avg?.toFixed(2)} · SL ₹${s.sl||"—"}</div></div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0">
          <span class="stag" style="color:${sg.c};border-color:${sg.c};background:${sg.c}20">${sg.s}</span>
          <span style="color:${pc(pnl)};font-weight:800;font-family:monospace;font-size:13px">${ps(pnl)}</span>
        </div>
      </div>
      <div class="cbox" style="background:${cbg};border-color:${cbr};color:${alert?sg.c:'#bae6fd'};margin-bottom:10px">→ ${cl}</div>
      <div class="mgrid">
        <div class="mc"><div class="ml">DECAY</div><div class="mv" style="color:${dc(sg.d)}">${sg.d.toFixed(0)}%</div></div>
        <div class="mc"><div class="ml">SL AMOUNT</div><div class="mv" style="color:#f87171">${inr(s.slAmt||0)}</div></div>
        <div class="mc"><div class="ml">BB TARGET</div><div class="mv" style="color:#60a5fa">₹${sg.bb}</div></div>
      </div>
    </div>`;
  });
  document.getElementById("cnt").innerHTML=h;
}

function renderChecklist(){
  const secs=[
    {t:"🌅 Pre-Market · 1:45pm Sydney / 9:15am IST",c:"#60a5fa",items:["Check India VIX direction","Check Bank Nifty futures trend","Refresh dashboard — check live positions","Any news/events for basket stocks?","Verify all GTT orders active in Upstox"]},
    {t:"📊 Market Structure Read",c:"#a78bfa",items:["Is market trending up, down or sideways?","Which stocks moving WITH market? Which against?","Global cues — US markets, crude, USD/INR?","Read structure before acting — not rules","Identify positions needing action"]},
    {t:"🌙 End of Day · 8pm Sydney / 3:30pm IST",c:"#34d399",items:["Note day P&L and overall P&L","Which positions changed today?","Any SL levels close to current LTP?","Plan tomorrow's buy-back or roll-up","Refresh dashboard one final time"]},
  ];
  let h=`<div style="color:#93c5fd;font-size:12px;margin-bottom:14px">Tap each item to check off</div>`;
  secs.forEach(sec=>{
    h+=`<div class="csec" style="border-color:${sec.c}50"><div style="color:${sec.c};font-weight:800;font-size:13px;margin-bottom:12px">${sec.t}</div>`;
    sec.items.forEach((item,i)=>{
      const k=`${sec.t}-${i}`,done=checks[k];
      h+=`<div class="citm" onclick="toggleChk('${k}')"><div class="cbx" style="border-color:${done?sec.c:'#334155'};background:${done?sec.c:'transparent'}">${done?'<span style="color:#fff;font-size:13px;font-weight:900">✓</span>':""}</div><div style="color:${done?'#475569':'#e2e8f0'};font-size:13px;line-height:1.6;text-decoration:${done?'line-through':'none'}">${item}</div></div>`;
    });
    h+=`</div>`;
  });
  h+=`<button style="width:100%;background:#1e3a5f;border:none;color:#f8fafc;border-radius:10px;padding:14px;cursor:pointer;font-size:13px;font-weight:700" onclick="checks={};renderChecklist()">🔄 Reset All</button>`;
  document.getElementById("cnt").innerHTML=h;
}

function toggleChk(k){checks[k]=!checks[k];renderChecklist()}

updateTime();
setInterval(updateTime,30000);
fetchData();
setInterval(fetchData,30000);
</script>

